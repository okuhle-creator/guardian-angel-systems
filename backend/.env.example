# Guardian Angel Systems - Backend Environment Configuration

# Project Environment
ENVIRONMENT=development
PROJECT_NAME="Guardian Angel Systems (GAS)"

# Security & JWT Secrets (Change in production!)
SECRET_KEY=gas-techgium2026-production-super-secure-key-replace-in-prod-env
